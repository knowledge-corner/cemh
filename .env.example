# Copy to .env and fill in. NEVER commit .env — it holds real credentials.

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=clinic.example.in,www.clinic.example.in
CSRF_TRUSTED_ORIGINS=https://clinic.example.in,https://www.clinic.example.in

# Where the Django admin is mounted. Pick something unguessable. Trailing slash required.
ADMIN_URL=clinic-admin-7f3a2/

# ── Database ──────────────────────────────────────────────────────────────────
# DigitalOcean Managed Postgres supplies this; keep sslmode=require.
DATABASE_URL=postgres://user:password@host:25060/clinic_pms?sslmode=require

# ── Clinic identity ───────────────────────────────────────────────────────────
CLINIC_NAME=Endocrine & Diabetes Clinic
CLINIC_TAGLINE=Adult & Paediatric Endocrinology
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=

# Prefix for generated patient IDs, e.g. KEC-26-00137
PATIENT_ID_PREFIX=KEC

# ── Feature modules ───────────────────────────────────────────────────────────
# Comma-separated speciality apps. Drop "growth" for a clinic with no use for
# paediatric growth charts. Leave empty for none.
OPTIONAL_APPS=growth

# Growth reference standard: WHO | IAP | CDC
GROWTH_REFERENCE=WHO
PAEDIATRIC_AGE_LIMIT=18

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@clinic.example.in

# ── Storage ───────────────────────────────────────────────────────────────────
# Uploaded investigation reports. Must be on a persistent volume.
MEDIA_ROOT=/data/media
